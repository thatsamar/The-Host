# Copy to .env.local for local development. On Vercel, set the same values in
# Project Settings → Environment Variables. Never commit real values.

# ── Supabase (sign-in only) ─────────────────────────────────────────────────
# Project URL and publishable key: Supabase Dashboard → Project Settings → API
# Keys. Locally, `npx supabase start` prints both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (The Vercel Supabase integration sets NEXT_PUBLIC_SUPABASE_ANON_KEY instead; Gio accepts either.)

# ── Anthropic ───────────────────────────────────────────────────────────────
# platform.claude.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Leave unset to use https://api.anthropic.com.
# ANTHROPIC_BASE_URL=

# Model for Gio's answers.
GIO_CHAT_MODEL=claude-opus-5-5
# How hard Gio thinks before answering: low | medium | high | xhigh | max.
# Higher is slower and costs more.
GIO_CHAT_EFFORT=high
# Max web searches per answer, for live prices and availability. 0 turns it off.
GIO_WEB_SEARCH_MAX_USES=5

# ── Privacy ─────────────────────────────────────────────────────────────────
# Turns off Next.js build telemetry. The npm scripts already set it; set it on
# Vercel too.
NEXT_TELEMETRY_DISABLED=1
