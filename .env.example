# Copy to .env.local for local development. On Vercel, set the same values in
# Project Settings → Environment Variables. Never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and publishable (client) key. Supabase Dashboard → Project
# Settings → API Keys. Locally, `npx supabase start` prints both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret (service role) key. Used ONLY by `npm run bootstrap` on your machine
# to create the household account. The app never reads it. Do not add it to
# Vercel.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Household account (bootstrap only) ──────────────────────────────────────
# The single login Courtney and Amar share. Read by `npm run bootstrap`; not
# needed on Vercel. Use a long password (12+ characters).
GIO_ACCOUNT_EMAIL=
GIO_ACCOUNT_PASSWORD=

# ── Anthropic ───────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Leave unset to use https://api.anthropic.com.
# ANTHROPIC_BASE_URL=

# Model for Gio's replies.
GIO_CHAT_MODEL=claude-opus-5-5
# Model for background work: chat titles now, image captions and memory
# extraction in later phases.
GIO_BACKGROUND_MODEL=claude-haiku-4-5-20251001
# How hard Gio thinks before answering: low | medium | high | xhigh | max.
# Higher is slower and costs more.
GIO_CHAT_EFFORT=high
# Max web searches per reply, used for live prices and availability.
# 0 turns web search off.
GIO_WEB_SEARCH_MAX_USES=5

# ── Voyage AI embeddings (used from Phase 2) ────────────────────────────────
# dashboard.voyageai.com → API Keys.
VOYAGE_API_KEY=
# Must match the vector(...) columns in supabase/migrations. voyage-4 defaults
# to 1024 dimensions. To change either value, add a migration that alters
# chunks.embedding and memories.embedding, then re-index.
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSION=1024

# ── Privacy ─────────────────────────────────────────────────────────────────
# Turns off Next.js build telemetry. The npm scripts already set it; set it on
# Vercel too.
NEXT_TELEMETRY_DISABLED=1
