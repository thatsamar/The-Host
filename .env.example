# Copy to .env.local for local development. On Vercel, set the same values in
# Project Settings → Environment Variables. Never commit real values.

# ── Which companion this deployment is ──────────────────────────────────────
# gio (design, the default), tony (travel) or martini (style). One codebase, one Vercel project
# per companion; set this on each project. Read at build time, so redeploy
# after changing it.
COMPANION=gio

# ── Access ──────────────────────────────────────────────────────────────────
# Open by default: anyone with the address can use the app, no sign-in. Set to
# true to require sign-in (Supabase settings below, and INVITE_CODE for links).
# REQUIRE_SIGN_IN=true
# Questions allowed per visitor per hour (default 40; 0 turns the cap off).
# Set a monthly spend limit at platform.claude.com too.
# QUESTIONS_PER_HOUR=40

# ── Supabase (sign-in only) ─────────────────────────────────────────────────
# Project URL and publishable key: Supabase Dashboard → Project Settings → API
# Keys. Locally, `npx supabase start` prints both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (The Vercel Supabase integration sets NEXT_PUBLIC_SUPABASE_ANON_KEY instead; Gio accepts either.)

# ── Invitations (optional) ──────────────────────────────────────────────────
# Set on a deployment to let people in with a link, /join/<INVITE_CODE>: they
# enter an email and are signed in, no password. Use something long and hard to
# guess (8+ characters). Change it to retire every link sent so far. Leave
# unset to allow only accounts created in Supabase.
# INVITE_CODE=
# Needs the Supabase secret (service role) key, server-side only. The Vercel
# Supabase integration sets SUPABASE_SERVICE_ROLE_KEY for you.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ───────────────────────────────────────────────────────────────
# platform.claude.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Leave unset to use https://api.anthropic.com.
# ANTHROPIC_BASE_URL=

# Model for answers. (The older GIO_CHAT_MODEL name still works.)
CHAT_MODEL=claude-opus-5-5
# How hard the companion thinks before answering: low | medium | high | xhigh |
# max. Higher is slower and costs more.
CHAT_EFFORT=high
# Max web searches per answer. Unset uses the companion's default (Gio 5,
# Tony 8); 0 turns search off.
# WEB_SEARCH_MAX_USES=

# ── Privacy ─────────────────────────────────────────────────────────────────
# Turns off Next.js build telemetry. The npm scripts already set it; set it on
# Vercel too.
NEXT_TELEMETRY_DISABLED=1
