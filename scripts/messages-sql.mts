// Writes the messaging channel's migrations from the code that owns them, so
// the SQL reviewed and applied at launch is exactly what the store expects.
//   npm run messages:sql
// Nothing here connects to a database.

import { writeFileSync } from "node:fs";
import { CHANNEL_SCHEMA, sweepSchedule } from "../src/lib/channel/postgres-store";
import { retention } from "../src/lib/channel/retention";

const header = (what: string) =>
  `-- Cinq messaging channel: ${what}\n-- Generated by \`npm run messages:sql\` from src/lib/channel/postgres-store.ts. Edit the code, not this file.\n`;

writeFileSync(new URL("../db/messages/0001_channel.sql", import.meta.url), `${header("tables, row-level security and the retention function")}${CHANNEL_SCHEMA.trim()}\n`);
writeFileSync(
  new URL("../db/messages/0002_retention_schedule.sql", import.meta.url),
  `${header("the retention job, every 15 minutes, inside the database (needs pg_cron; on Supabase, enable Cron under Integrations first)")}create extension if not exists pg_cron;\n${sweepSchedule(retention("24"))}\n`,
);
console.log("Wrote db/messages/0001_channel.sql and db/messages/0002_retention_schedule.sql");
