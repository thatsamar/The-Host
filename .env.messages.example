# Cinq in Apple Messages for Business: configuration names only. No values here,
# and none committed anywhere: set real values in the server environment
# (Vercel → Settings → Environment Variables) once a provider is chosen.
# Nothing reads the provider or database settings yet; see
# docs/messages-channel.md for what is still to build.

# ── Channel switch ───────────────────────────────────────────────────────────
# Leave unset. The channel has no public route until launch work mounts it,
# and that route should refuse requests unless this is set.
MESSAGES_CHANNEL_ENABLED=

# ── Messaging service provider (names depend on the provider chosen) ─────────
# Which adapter to use, e.g. the provider's short name.
MESSAGES_PROVIDER=
# Whatever the provider's documentation says it needs to verify its webhooks
# and to call its API. Typical shapes; rename to match the provider's docs.
MESSAGES_PROVIDER_WEBHOOK_SECRET=
MESSAGES_PROVIDER_API_KEY=
MESSAGES_PROVIDER_ACCOUNT_ID=
# Apple Messages for Business account identifier, if the provider asks for it.
MESSAGES_BUSINESS_ID=

# ── Durable store ────────────────────────────────────────────────────────────
# Postgres for src/lib/channel/postgres-store.ts. Server-side only.
MESSAGES_DATABASE_URL=

# ── Behavior (optional; defaults shown in docs/messages-channel.md) ──────────
# Hours a conversation's context is kept after its last message (1 to 72, default 24).
MESSAGES_CONTEXT_HOURS=
# Questions per conversation per hour (shared with the website's setting, default 40).
QUESTIONS_PER_HOUR=

# ── Shared with the website (already set on each Cinq project) ────────────────
ANTHROPIC_API_KEY=
CHAT_MODEL=
CHAT_EFFORT=
WEB_SEARCH_MAX_USES=
