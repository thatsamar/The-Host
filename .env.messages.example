# Cinq in Apple Messages for Business: configuration names only. No values here,
# and none committed anywhere. Set real values on the ONE Vercel project that
# carries the channel (Settings → Environment Variables). See
# docs/messages-channel.md.

# ── Switch ────────────────────────────────────────────────────────────────────
# The /api/messages routes answer 404 unless this is exactly "true".
MESSAGES_CHANNEL_ENABLED=

# ── Provider: Blooio (Apple Messages for Business only) ──────────────────────
MESSAGES_PROVIDER=blooio
# API key (Authorization: Bearer) and the webhook's signing secret (shown once
# when the webhook is created).
BLOOIO_API_KEY=
BLOOIO_WEBHOOK_SECRET=
# Comma-separated hostnames Blooio serves attachment downloads from. Nothing
# else is fetched. Confirm with Blooio.
MESSAGES_ATTACHMENT_HOSTS=
# Longest text per message. Default 2000 until Blooio confirms Apple's limit.
MESSAGES_MAX_TEXT_CHARS=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string (for Supabase, the transaction pooler). Server only.
MESSAGES_DATABASE_URL=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Secret for /api/messages/run-due (sent as Authorization: Bearer <secret>);
# at least 16 characters.
CRON_SECRET=

# ── Behavior (optional) ──────────────────────────────────────────────────────
# Hours of inactivity before a conversation's context is deleted (1 to 72,
# default 24). The database removes it within 15 minutes after that.
MESSAGES_CONTEXT_HOURS=
# "false" turns off decoding iPhone HEIC photos on the server.
MESSAGES_HEIC_DECODE=
# Questions per conversation per hour (shared with the website's setting, default 40).
QUESTIONS_PER_HOUR=

# ── Shared with the website (already set on each Cinq project) ────────────────
ANTHROPIC_API_KEY=
CHAT_MODEL=
CHAT_EFFORT=
WEB_SEARCH_MAX_USES=
